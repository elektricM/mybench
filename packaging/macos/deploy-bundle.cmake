# Install-time Qt deployment of MYBENCH.app (included by an install(CODE) rule of packaging/).
#
#   1. macdeployqt with -qmldir on the shipped QML sources (app/, ui/controls/, instruments/):
#      qmlimportscanner finds the Qt QML modules we import (QtQuick.Controls, Dialogs, Effects,
#      Shapes, Layouts, QtCore, ...) and macdeployqt copies them, the Qt frameworks, the Qt
#      plugins and every non-system dylib (libusb) into the bundle, rewriting install names.
#   2. Prune what the app never loads: QML modules that qmlimportscanner does not report
#      (macdeployqt copies whole directory trees), our own MyBench.* modules (linked statically;
#      the copied qmldir files would only shadow them), the Qt Quick Controls styles other than
#      Basic (the app always uses MyBench.Style, built on Basic), unused plugin types, then every
#      framework or dylib no longer reachable from what is left.
#   3. Check: no Mach-O file in the bundle may reference a library outside the bundle other than
#      the system's (/System, /usr/lib), and every @rpath/@loader_path/@executable_path
#      reference must resolve inside the bundle.
#
# Inputs: MYBENCH_BUNDLE, MYBENCH_MACDEPLOYQT, MYBENCH_QMLIMPORTSCANNER, MYBENCH_QT_QML_DIR,
#         MYBENCH_QML_SOURCE_DIRS (list), MYBENCH_QML_IMPORT_DIRS (list),
#         MYBENCH_QT_PLUGINS_DIR, MYBENCH_EXTRA_PLUGINS (list, relative to the plugins dir).

if(NOT IS_DIRECTORY "${MYBENCH_BUNDLE}")
    message(FATAL_ERROR "deploy-bundle: ${MYBENCH_BUNDLE} not found")
endif()
get_filename_component(MYBENCH_BUNDLE "${MYBENCH_BUNDLE}" REALPATH)   # paths are compared below
set(_contents "${MYBENCH_BUNDLE}/Contents")

# --- 1. macdeployqt ----------------------------------------------------------------------------
set(_args "${MYBENCH_BUNDLE}" -always-overwrite -verbose=1)
# Extra Qt plugins macdeployqt does not pick by itself: the offscreen platform (headless
# `--screenshot` rendering, CI smoke tests). Copied first, then fixed up by macdeployqt.
foreach(p IN LISTS MYBENCH_EXTRA_PLUGINS)
    if(EXISTS "${MYBENCH_QT_PLUGINS_DIR}/${p}")
        get_filename_component(_sub "${p}" DIRECTORY)
        file(COPY "${MYBENCH_QT_PLUGINS_DIR}/${p}" DESTINATION "${_contents}/PlugIns/${_sub}")
        list(APPEND _args "-executable=${_contents}/PlugIns/${p}")
    else()
        message(WARNING "Qt plugin ${p} not found in ${MYBENCH_QT_PLUGINS_DIR}")
    endif()
endforeach()
foreach(d IN LISTS MYBENCH_QML_SOURCE_DIRS)
    list(APPEND _args "-qmldir=${d}")
endforeach()
foreach(d IN LISTS MYBENCH_QML_IMPORT_DIRS)
    list(APPEND _args "-qmlimport=${d}")
endforeach()
message(STATUS "Deploying Qt: ${MYBENCH_MACDEPLOYQT}")
execute_process(COMMAND "${MYBENCH_MACDEPLOYQT}" ${_args}
                RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _out)
# macdeployqt reports non-fatal problems as "ERROR:" lines (e.g. its own codesign check after
# rewriting install names, or @rpath entries it cannot follow); step 3 is the real check.
string(REGEX MATCHALL "ERROR:[^\n]*" _errors "${_out}")
list(FILTER _errors EXCLUDE REGEX "ERROR: \"\"$|codesign verification error|invalid signature|In subcomponent|In architecture")
list(LENGTH _errors _nerrors)
if(_nerrors GREATER 0)
    message(STATUS "macdeployqt reported ${_nerrors} problem(s) (checked below):")
    list(REMOVE_DUPLICATES _errors)
    foreach(e IN LISTS _errors)
        message(STATUS "  ${e}")
    endforeach()
endif()
if(_rc)
    message(FATAL_ERROR "macdeployqt failed (${_rc}):\n${_out}")
endif()

# --- 2. prune ----------------------------------------------------------------------------------
# macdeployqt copies whole import directories (all of QtQuick/, i.e. every add-on module
# installed under it). Keep only the modules qmlimportscanner reports, minus the unused styles.
set(_qml "${_contents}/Resources/qml")
set(_scan_args "")
foreach(d IN LISTS MYBENCH_QML_SOURCE_DIRS)
    list(APPEND _scan_args -rootPath "${d}")
endforeach()
foreach(d IN LISTS MYBENCH_QML_IMPORT_DIRS MYBENCH_QT_QML_DIR)
    list(APPEND _scan_args -importPath "${d}")
endforeach()
execute_process(COMMAND "${MYBENCH_QMLIMPORTSCANNER}" ${_scan_args}
                OUTPUT_VARIABLE _json ERROR_QUIET RESULT_VARIABLE _rc)
if(_rc)
    message(FATAL_ERROR "qmlimportscanner failed (${_rc})")
endif()
set(_unused_modules   # the app always uses MyBench.Style (on Basic); MyBench.* are static
    "^MyBench" "^QtQuick/Controls/(Fusion|Imagine|Material|Universal|FluentWinUI3|macOS|iOS)(/|$)"
    "^QtQuick/NativeStyle$")
set(_modules "")
string(JSON _count LENGTH "${_json}")
math(EXPR _last "${_count} - 1")
foreach(i RANGE ${_last})
    string(JSON _type ERROR_VARIABLE _e GET "${_json}" ${i} type)
    string(JSON _rel ERROR_VARIABLE _e GET "${_json}" ${i} relativePath)
    if(NOT _type STREQUAL "module" OR NOT _rel)
        continue()
    endif()
    set(_skip FALSE)
    foreach(re IN LISTS _unused_modules)
        if(_rel MATCHES "${re}")
            set(_skip TRUE)
        endif()
    endforeach()
    if(NOT _skip)
        list(APPEND _modules "${_rel}")
    endif()
endforeach()
list(REMOVE_DUPLICATES _modules)
list(JOIN _modules " " _modules_text)
message(STATUS "QML modules shipped: ${_modules_text}")
# Walk qml/: keep needed modules and their ancestors; inside a needed module keep plain
# resource directories but drop nested modules (a directory with a qmldir) that are not needed.
function(_prune_dir dir rel)
    file(GLOB _children LIST_DIRECTORIES true "${dir}/*")
    foreach(c IN LISTS _children)
        if(NOT IS_DIRECTORY "${c}" OR IS_SYMLINK "${c}")
            continue()
        endif()
        get_filename_component(_name "${c}" NAME)
        if(rel)
            set(_crel "${rel}/${_name}")
        else()
            set(_crel "${_name}")
        endif()
        set(_needed FALSE)
        set(_ancestor FALSE)
        foreach(m IN LISTS _modules)
            if(m STREQUAL _crel)
                set(_needed TRUE)
            else()
                string(FIND "${m}" "${_crel}/" _pos)
                if(_pos EQUAL 0)
                    set(_ancestor TRUE)
                endif()
            endif()
        endforeach()
        if(_needed OR _ancestor)
            _prune_dir("${c}" "${_crel}")
        elseif(EXISTS "${c}/qmldir" OR _name STREQUAL "designer" OR NOT rel)
            file(REMOVE_RECURSE "${c}")
        else()
            _prune_dir("${c}" "${_crel}")   # resources of a needed module; may nest modules
        endif()
    endforeach()
endfunction()
_prune_dir("${_qml}" "")
# Qt plugin types: keep only those the app uses (macdeployqt adds the plugins of every framework
# it copied, e.g. Qt 3D's renderers/sceneparsers because QtQuick/Scene3D lives under QtQuick/).
# imageformats: PNG and JPEG are built into QtGui; keep SVG only (icons).
set(_plugin_types platforms iconengines imageformats multimedia quick)
file(GLOB _plugin_dirs LIST_DIRECTORIES true "${_contents}/PlugIns/*")
foreach(d IN LISTS _plugin_dirs)
    get_filename_component(_name "${d}" NAME)
    if(IS_DIRECTORY "${d}" AND NOT _name IN_LIST _plugin_types)
        file(REMOVE_RECURSE "${d}")
    endif()
endforeach()
file(GLOB _imageformats "${_contents}/PlugIns/imageformats/*")
foreach(f IN LISTS _imageformats)
    get_filename_component(_name "${f}" NAME)
    if(NOT _name MATCHES "qsvg")
        file(REMOVE "${f}")
    endif()
endforeach()
# QML plugin binaries: macdeployqt places them in PlugIns/quick and links them from qml/; drop
# the ones whose module directory is gone (dangling links).
file(GLOB_RECURSE _qml_links LIST_DIRECTORIES false "${_qml}/*")
foreach(f IN LISTS _qml_links)
    if(IS_SYMLINK "${f}" AND NOT EXISTS "${f}")
        file(REMOVE "${f}")
    endif()
endforeach()

# Mach-O files and their dependencies (otool -L).
function(_macho_files out)
    file(GLOB_RECURSE _all LIST_DIRECTORIES false "${_contents}/*")
    set(_result "")
    foreach(f IN LISTS _all)
        get_filename_component(_name "${f}" NAME)
        # Mach-O candidates: *.dylib/*.so and extension-less files (executables, frameworks).
        if(IS_SYMLINK "${f}" OR NOT (_name MATCHES "\\.(dylib|so)$" OR NOT _name MATCHES "\\."))
            continue()
        endif()
        execute_process(COMMAND file -b "${f}" OUTPUT_VARIABLE _type ERROR_QUIET)
        if(_type MATCHES "Mach-O")
            list(APPEND _result "${f}")
        endif()
    endforeach()
    set(${out} "${_result}" PARENT_SCOPE)
endfunction()
function(_deps file out)
    execute_process(COMMAND otool -D "${file}" OUTPUT_VARIABLE _id ERROR_QUIET)
    set(_own "")
    if(_id MATCHES ":\n([^\n]+)")   # "<file>:\n<install id>"
        string(STRIP "${CMAKE_MATCH_1}" _own)
    endif()
    set(_id "${_own}")
    execute_process(COMMAND otool -L "${file}" OUTPUT_VARIABLE _l ERROR_QUIET)
    string(REPLACE "\n" ";" _lines "${_l}")
    list(REMOVE_AT _lines 0)   # "<file>:"
    set(_result "")
    foreach(line IN LISTS _lines)
        if(line MATCHES "^[ \t]+([^ ]+) \\(" AND NOT CMAKE_MATCH_1 STREQUAL _id)
            list(APPEND _result "${CMAKE_MATCH_1}")   # (the library's own id excluded)
        endif()
    endforeach()
    set(${out} "${_result}" PARENT_SCOPE)
endfunction()
# Resolve a dependency of <file> to a path inside the bundle ("" if it is a system library).
function(_resolve file dep out)
    get_filename_component(_dir "${file}" DIRECTORY)
    set(_path "")
    if(dep MATCHES "^@executable_path/(.*)")
        set(_path "${_contents}/MacOS/${CMAKE_MATCH_1}")
    elseif(dep MATCHES "^@loader_path/(.*)")
        set(_path "${_dir}/${CMAKE_MATCH_1}")
    elseif(dep MATCHES "^@rpath/(.*)")
        # Deployed binaries use @executable_path/../Frameworks (and @loader_path) as rpaths.
        set(_rel "${CMAKE_MATCH_1}")
        foreach(base "${_contents}/Frameworks" "${_dir}")
            if(EXISTS "${base}/${_rel}")
                set(_path "${base}/${_rel}")
                break()
            endif()
        endforeach()
        if(NOT _path)
            set(_path "${_contents}/Frameworks/${_rel}")
        endif()
    elseif(dep MATCHES "^/(System|usr/lib)/")
        set(_path "")
    else()
        set(_path "EXTERNAL:${dep}")
    endif()
    if(_path AND NOT _path MATCHES "^EXTERNAL:")
        get_filename_component(_path "${_path}" REALPATH)
    endif()
    set(${out} "${_path}" PARENT_SCOPE)
endfunction()

# Reachability from the executable, the Qt plugins and the QML plugins that are left.
_macho_files(_macho)
set(_roots "")
foreach(f IN LISTS _macho)
    string(FIND "${f}" "${_contents}/Frameworks/" _in_fw)
    if(NOT _in_fw EQUAL 0)
        list(APPEND _roots "${f}")
    endif()
endforeach()
# QML plugins live in PlugIns/quick but are only loaded through a qmldir that still exists.
set(_qml_plugins_used "")
file(GLOB_RECURSE _qmldirs "${_qml}/qmldir")
foreach(q IN LISTS _qmldirs)
    get_filename_component(_qdir "${q}" DIRECTORY)
    file(GLOB _libs "${_qdir}/*.dylib")
    foreach(l IN LISTS _libs)
        get_filename_component(_real "${l}" REALPATH)
        list(APPEND _qml_plugins_used "${_real}")
    endforeach()
endforeach()
set(_queue "")
foreach(f IN LISTS _roots)
    get_filename_component(_real "${f}" REALPATH)
    string(FIND "${_real}" "${_contents}/PlugIns/quick/" _is_qml_plugin)
    if(_is_qml_plugin EQUAL 0 AND NOT _real IN_LIST _qml_plugins_used)
        file(REMOVE "${f}")   # QML plugin of a pruned module
        continue()
    endif()
    list(APPEND _queue "${_real}")
endforeach()
set(_reached "")
while(_queue)
    list(POP_FRONT _queue f)
    if(f IN_LIST _reached)
        continue()
    endif()
    list(APPEND _reached "${f}")
    _deps("${f}" _ds)
    foreach(d IN LISTS _ds)
        _resolve("${f}" "${d}" _p)
        if(_p AND NOT _p MATCHES "^EXTERNAL:" AND EXISTS "${_p}" AND NOT _p IN_LIST _reached)
            list(APPEND _queue "${_p}")
        endif()
    endforeach()
endwhile()
# Remove unreachable frameworks and dylibs.
file(GLOB _fw_entries "${_contents}/Frameworks/*")
foreach(e IN LISTS _fw_entries)
    get_filename_component(_name "${e}" NAME)
    set(_used FALSE)
    foreach(r IN LISTS _reached)
        string(FIND "${r}" "${e}/" _pos)
        if(r STREQUAL e OR _pos EQUAL 0)
            set(_used TRUE)
            break()
        endif()
    endforeach()
    if(NOT _used)
        message(STATUS "Pruning unused ${_name}")
        file(REMOVE_RECURSE "${e}")
    endif()
endforeach()

# --- 3. check -----------------------------------------------------------------------------------
_macho_files(_macho)
# Libraries keep their original install id (e.g. /opt/homebrew/opt/qtbase/lib/...); it is not
# used at run time, but set it to @rpath/... so nothing in the bundle names a build-machine path.
foreach(f IN LISTS _macho)
    string(FIND "${f}" "${_contents}/Frameworks/" _pos)
    if(NOT _pos EQUAL 0)
        continue()
    endif()
    execute_process(COMMAND otool -D "${f}" OUTPUT_VARIABLE _id ERROR_QUIET)
    if(_id MATCHES ":\n(/[^\n]+)")
        file(RELATIVE_PATH _rel "${_contents}/Frameworks" "${f}")
        execute_process(COMMAND install_name_tool -id "@rpath/${_rel}" "${f}" ERROR_QUIET)
    endif()
endforeach()
set(_problems "")
foreach(f IN LISTS _macho)
    _deps("${f}" _ds)
    foreach(d IN LISTS _ds)
        _resolve("${f}" "${d}" _p)
        if(_p MATCHES "^EXTERNAL:")
            list(APPEND _problems "${f} -> ${d} (outside the bundle)")
        elseif(_p AND NOT EXISTS "${_p}")
            list(APPEND _problems "${f} -> ${d} (missing)")
        endif()
    endforeach()
endforeach()
if(_problems)
    string(REPLACE ";" "\n  " _problems "${_problems}")
    message(FATAL_ERROR "The deployed bundle is not self-contained:\n  ${_problems}")
endif()
list(LENGTH _macho _n)
message(STATUS "Bundle: ${_n} Mach-O files, all dependencies inside the bundle or the system")
