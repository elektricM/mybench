prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libmydaq
Description: Native driver library for the NI myDAQ (static, C11, libusb)
Version: @PROJECT_VERSION@
Requires.private: libusb-1.0
Libs: -L${libdir} -lmydaq
Libs.private: @LIBMYDAQ_PC_LIBS_PRIVATE@
Cflags: -I${includedir}
